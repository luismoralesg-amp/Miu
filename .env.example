# Only the NAMES of the variables. Real values go in .env.local (ignored by git) and in Vercel.

# Signs the demo's cookies (session, payments, Google state). Any long random string.
# Generate one with: openssl rand -base64 32
MIU_SESSION_SECRET=

# Google sign-in (docs/GOOGLE_CLOUD.md). With the first two missing, the demo uses the simulated account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact redirect URI registered in Google Cloud Console for THIS environment. Required off localhost.
GOOGLE_REDIRECT_URI=
# Set to "mock" to use the simulated account even with the credentials loaded.
MIU_GOOGLE_MODE=

# Adapters: mock | real (src/lib/adapters.ts). Leave unset for the demo.
MIU_ADAPTER_IDENTITY=
MIU_ADAPTER_PAYMENTS=

# Recurrente (only with MIU_ADAPTER_PAYMENTS=real)
RECURRENTE_WEBHOOK_SECRET=

# Shows the developer tools (role switcher, mock outbox) in a production build. Not for real data.
MIU_DEV_TOOLS=
